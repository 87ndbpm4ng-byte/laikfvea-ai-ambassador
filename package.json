{
  "name": "ai-ambassador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "import:manual": "tsx imports/cli/import-manual.ts",
    "test:imports": "tsx --test imports/tests/manual-import.test.ts",
    "test:retrieval": "tsx --test lib/retrieval/tests/retrieval.test.ts",
    "test:conversation": "tsx --test lib/conversation/tests/response-engine.test.ts",
    "test:prompts": "tsx --test lib/orchestrator/tests/prompt-builder.test.ts",
    "test:session-context": "tsx --test lib/session/tests/conversation-context.test.ts",
    "test:multi-source": "tsx --test lib/retrieval/tests/multi-source.test.ts",
    "test:voice": "tsx --test lib/voice/tests/*.test.ts",
    "test:liveavatar": "tsx --test lib/liveavatar/tests/*.test.ts",
    "test:frontend": "tsx --test lib/ui/tests/*.test.tsx"
  },
  "dependencies": {
    "@heygen/liveavatar-web-sdk": "^0.0.18",
    "next": "^16.2.12",
    "openai": "^7.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.0"
  }
}
